# --- Instance workflow (every script) ---
UPLINK_NETWORK='UPLINK'
IPV4_SUBNET_PREFIX='10.127'
# Each project network's router (and default outbound NAT) address is
# <PROJECT_NAT_IPV4_PREFIX>.<project id>; the default project's network uses the
# last address of UPLINK_IPV4_OVN_RANGES.
PROJECT_NAT_IPV4_PREFIX='172.31.232'
STORAGE_POOL='zpool'
NFS_BACKUP_DIR='/mnt/incus-backups'
BACKUP_RETENTION_DAYS='7'
BACKUP_WEEKLY_RETENTION_WEEKS='3'
BACKUP_RETENTION_MONTHS='6'
TECHNITIUM_URL='http://dns.example.infnet:5380'
TECHNITIUM_API_TOKEN='replace-with-technitium-api-token'
TECHNITIUM_ZONE='infnet'
TECHNITIUM_DNS_TTL='3600'

# --- Host bootstrap (host/setup-incus-host.sh only) ---
INCUS_CHANNEL='stable'
INCUS_ADMIN_USER='kauffpc'
# Disk (or partition) for the ZFS pool. Leave empty on hosts whose only disk
# holds the OS, and set STORAGE_LOOP_SIZE for a loop-file pool instead.
STORAGE_DEVICE='/dev/disk/by-id/nvme-EXAMPLE_SERIAL'
STORAGE_LOOP_SIZE=''
# Or an existing, empty ZFS dataset on a pool the host already has (e.g. a
# Proxmox host's pool): Incus uses it and never creates or wipes pools/disks.
STORAGE_DATASET=''
# This host's management IP: OVN tunnel endpoint and, once clustered, its cluster address.
OVN_ENCAP_IP='192.0.2.10'
# Clusters only (cluster-enable.sh / cluster-join.sh): the OVN_ENCAP_IPs of the
# hosts that run the OVN databases as a RAFT cluster, comma-separated. Use
# three, list the same value on every member, and include the first host.
OVN_CENTRAL_ADDRESSES=''
UPLINK_PARENT='enp5s0f0np0'
UPLINK_IPV4_GATEWAY='172.31.232.1/21'
# Router addresses: one per project network (<PROJECT_NAT_IPV4_PREFIX>.<project
# ID>), also its default outbound NAT address. Keep them inside
# PROJECT_NAT_IPV4_PREFIX.0/24; the last address is the default network's.
UPLINK_IPV4_OVN_RANGES='172.31.232.2-172.31.232.254'
# Public 1:1 NAT addresses are handed out from these routes (random free address unless one is requested).
UPLINK_IPV4_ROUTES='172.31.233.0/24,172.31.234.0/23,172.31.236.0/22'
UPLINK_DNS_NAMESERVERS='1.1.1.1,9.9.9.9'
NFS_BACKUP_SOURCE='nfs-server.example.com:/export/incus-backups'

# --- Authentik OIDC (host/setup-incus-host.sh only; leave blank to skip) ---
OIDC_ISSUER='https://auth.example.com/application/o/incus/'
OIDC_CLIENT_ID=''
OIDC_AUDIENCE=''
OIDC_SCOPES='openid,offline_access,email,profile'

# MTU of new project networks (deploy-project.sh). 1442 fits OVN's tunnel
# overhead on a 1500-MTU host network; use 1500 when the hosts' tunnel
# interface (OVN_ENCAP_IP) runs jumbo frames (MTU 9000, as on us-west).
OVN_MTU='1442'

# Timezone that new Linux instances get from their profile's cloud-init
# (deploy-project.sh; re-run it with --update-payloads after changing it).
# Empty = the one in cloud-init-user-data.yaml (America/Phoenix).
INSTANCE_TIMEZONE='America/Phoenix'

# Daily health report email (host/cluster-health-mail.sh and its timer):
# recipient, sender, SMTP relay (host[:port], no auth) and the cluster name
# used in the subject (default: this host's name).
HEALTH_MAIL_TO=''
HEALTH_MAIL_FROM=''
SMTP_RELAY='pd17-pstfx-ct01.infnet:25'
HEALTH_CLUSTER_NAME=''

# Reverse proxy (proxy/npm-proxy-host.sh): an NPM user for the scripts, the
# address its proxy hosts get in internal DNS, and (optional) the Incus
# instance running NPM, to reuse its Cloudflare DNS-challenge credentials.
NPM_URL='http://npm.example:81'
NPM_EMAIL='infnet-scripts@example.com'
NPM_PASSWORD=''
NPM_DNS_TARGET='192.0.2.20'
NPM_INSTANCE=''
NPM_PROJECT=''
